# mftiko STS agent (E12-D016–E12-D019).
# KillMode=process: systemctl stop and restart signal only this process.
# systemctl kill is not limited by KillMode and kills the whole cgroup, including workers.

[Unit]
Description=mftiko STS agent
After=network-online.target etcd.service nats.service
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
User=mftiko-sts
# Log endpoint defaults (E14-D019–E14-D023). EnvironmentFile overrides these.
Environment=MFTIKO_LOG_LISTEN=:7442
Environment=MFTIKO_LOG_ADVERTISE=
Environment=MFTIKO_LOG_TOKEN_SHA256=
Environment=MFTIKO_LOG_MAX_STREAMS=16
Environment=MFTIKO_LOG_MAX_RATE=16777216
Environment=MFTIKO_LOG_MAX_BYTES=0
Environment=MFTIKO_LOG_KEEP=0
EnvironmentFile=/etc/mftiko/sts-agent/env
WorkingDirectory=/var/lib/mftiko/sts-agent
StateDirectory=mftiko/sts-agent
ExecStart=/opt/mftiko/current/bin/mftiko-sts-agent \
  -instance ${MFTIKO_INSTANCE} \
  -topology /etc/mftiko/sts-agent/topology.json \
  -work-dir /var/lib/mftiko/sts-agent \
  -data /var/lib/mftiko/sts-agent \
  -shim /opt/mftiko/current/bin/mftiko-shim \
  -plain-http-hosts ${MFTIKO_PLAIN_HTTP_HOSTS} \
  -registry-creds ${MFTIKO_REGISTRY_CREDS} \
  -data-repository ${MFTIKO_STS_DATA_REPOSITORY} \
  -nats-account ${MFTIKO_NATS_ACCOUNT} \
  -nats-signing-key /etc/mftiko/sts-agent/nats-signing.nk \
  -log-listen ${MFTIKO_LOG_LISTEN} \
  -log-advertise ${MFTIKO_LOG_ADVERTISE} \
  -log-token-sha256 ${MFTIKO_LOG_TOKEN_SHA256} \
  -log-max-streams ${MFTIKO_LOG_MAX_STREAMS} \
  -log-max-rate ${MFTIKO_LOG_MAX_RATE} \
  -log-max-bytes ${MFTIKO_LOG_MAX_BYTES} \
  -log-keep ${MFTIKO_LOG_KEEP}
Restart=always
RestartSec=1s
KillMode=process
OOMPolicy=continue
KillSignal=SIGTERM
TimeoutStopSec=30s

[Install]
WantedBy=multi-user.target
